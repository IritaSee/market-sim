# Salin file ini menjadi .env di root repo lalu isi nilainya.
# .env sudah ada di .gitignore, jadi kunci tidak ikut ter-commit.

# Kunci Gemini untuk agen LLM. Biarkan kosong untuk mode aturan saja.
GEMINI_API_KEY=

# Opsional: pengaturan agen LLM (nilai default ditampilkan).
# SIMPASAR_LLM=on                          # off = semua agen memakai aturan, tanpa Gemini
# SIMPASAR_LLM_MODEL=gemini-3.1-flash-lite
# SIMPASAR_LLM_RPM=12                      # batas request Gemini per menit
# SIMPASAR_LLM_MAX_REQUESTS=1000           # batas request per proses server (0 = tanpa batas)
# SIMPASAR_LLM_CONCURRENCY=4               # request paralel maksimum
# SIMPASAR_LLM_BATCH_SIZE=11               # maksimum agen sekepribadian per request
# SIMPASAR_LLM_SENTIMENT_WEIGHT=0.25        # pengaruh sentimen pada fallback (0 = mati)
# SIMPASAR_LLM_SENTIMENT_HALFLIFE_S=60      # waktu paruh sentimen dalam detik
# SIMPASAR_LLM_TIMEOUT_MS=25000            # batas waktu satu request (1000-120000)
# SIMPASAR_AGENT_LOG=0                     # 1 = cetak keputusan setiap agen setiap tick (sangat bising)

# Jangan aktifkan GOOGLE_GENAI_DEBUG saat memakai kunci asli: SDK mencetak header kunci ke log.

# Opsional: Sectors Financial MCP (harga IHSG, harga emiten via fetch-daily-price, berita).
# Keduanya boleh dikosongkan: sim/sectors.py memakai URL & kunci default tim bila tidak diset.
# Setiap panggilan API memotong kredit (1 kredit per emiten; hasil di-cache 6 jam di .cache/sectors/).
# IHSG di-cache 15 menit dan berita 10 menit (memori); setelah API gagal, panggilan baru ditahan 60 detik.
# scripts/dev_server.py menimpa SECTORS_MCP_URL menjadi offline:// kecuali dijalankan dengan --online.
# SECTORS_API_KEY=                          # kunci Bearer Sectors MCP Anda
# SECTORS_MCP_URL=https://sectors-mcp.supertype.ai/mcp   # set ke offline://x untuk mematikan panggilan API
# SECTORS_PRICE_MAX_PER_HOUR=120            # batas panggilan harga emiten per jam (0 = tanpa batas)

# Opsional: simbol yang tampil saat server dinyalakan (ticker emiten BEI atau IHSG; default BBCA).
# Nilai tidak dikenal -> BBCA. Harga awal lewat cache Sectors 6 jam (maks. 1 kredit per start);
# bila tidak tersedia dipakai nilai cadangan BBCA Rp6.200.
# Saham dibatasi ARA/ARB BEI (lihat README): Rp1-Rp10 +/-Rp1, Rp11-Rp200 +35%/-15%,
# >Rp200-Rp5.000 +25%/-15%, >Rp5.000 +20%/-15%. IHSG tidak dibatasi.
# SIMPASAR_START_SYMBOL=BBCA

# Opsional: origin tambahan yang boleh membuka WebSocket (default: host yang sama & localhost).
# SIMPASAR_ALLOWED_ORIGINS=https://simpasar.example
