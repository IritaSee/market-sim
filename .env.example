# Salin file ini menjadi .env di root repo lalu isi nilainya.
# .env sudah ada di .gitignore, jadi kunci tidak ikut ter-commit.

# Kunci Gemini untuk agen LLM. Biarkan kosong untuk mode aturan saja.
GEMINI_API_KEY=

# Opsional: pengaturan agen LLM (nilai default ditampilkan).
# SIMPASAR_LLM=on                          # off = semua agen memakai aturan, tanpa Gemini
# SIMPASAR_LLM_MODEL=gemini-3.1-flash-lite
# SIMPASAR_LLM_RPM=12                      # batas request Gemini per menit
# SIMPASAR_LLM_MAX_REQUESTS=1000           # batas request per proses server (0 = tanpa batas)
# SIMPASAR_LLM_CONCURRENCY=4               # request paralel maksimum
# SIMPASAR_LLM_TIMEOUT_MS=25000            # batas waktu satu request (1000-120000)
# SIMPASAR_AGENT_LOG=0                     # 1 = cetak keputusan setiap agen setiap tick (sangat bising)

# Jangan aktifkan GOOGLE_GENAI_DEBUG saat memakai kunci asli: SDK mencetak header kunci ke log.
